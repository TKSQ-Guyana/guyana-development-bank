            "url": "{{baseUrl}}/api/method/gdb_bank.documents.new_document",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document_type\": \"Identity\"\n}"
            },
            "description": "Omit `application` for a personal document; it follows the person across applications. Copy the returned `name` into documentName."
          }
        },
        {
          "name": "2. Upload the PDF (Frappe's own endpoint, multipart)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/method/upload_file",
            "description": "NOT a gdb_bank endpoint. Attaching to the shelf row is what makes the private file readable by the applicant and by staff and by nobody else — File.has_permission delegates to the attached doc.\n\nLeave Content-Type unset: Postman writes the multipart boundary. Pick a PDF for the `file` field (10 MB max).",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "doctype",
                  "value": "GDB Applicant Document",
                  "type": "text"
                },
                {
                  "key": "docname",
                  "value": "{{documentName}}",
                  "type": "text"
                },
                {
                  "key": "is_private",
                  "value": "1",
                  "type": "text"
                }
              ]
            }
          }
        },
        {
          "name": "3. Confirm the document",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.documents.confirm_document",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{documentName}}\"\n}"
            },
            "description": "Stamps the row, retires the previous document of the same type, and closes the information request it answers."
