          }
        },
        {
          "name": "Request information (underwriter)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.documents.request_information",
