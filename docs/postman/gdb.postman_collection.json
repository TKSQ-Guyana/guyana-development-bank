{
  "info": {
    "name": "GDB Citizen Loan Portal",
    "description": "Exercises the gdb_bank API through the frontend nginx proxy. Postman keeps the Frappe `sid` session cookie automatically — run a Login request first, everything after rides that session. Two ways in: email+password (Frappe's own login) and e-ID+password (Keycloak, realm gdb-citizen) — both end in the same sid session, so every request below works after either. Variables: baseUrl (default http://localhost:3000), password (default admin, the Frappe demo users), eidPassword (default ChangeMe@123, the Keycloak accounts).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "password",
      "value": "admin"
    },
    {
      "key": "eidPassword",
      "value": "ChangeMe@123"
    },
    {
      "key": "loanName",
      "value": "ACC-LOAP-2026-00001"
    },
    {
      "key": "documentName",
      "value": "GDB-DOC-2026-00001"
    },
    {
      "key": "requestName",
      "value": "GDB-REQ-2026-00001"
    },
    {
      "key": "memberEid",
      "value": "592-3333-0003"
    },
    {
      "key": "clusterName",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login — citizen",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usr\": \"citizen@example.gy\",\n  \"pwd\": \"{{password}}\"\n}"
            }
          }
        },
        {
          "name": "Login — underwriter",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usr\": \"underwriter@gdb.gov.gy\",\n  \"pwd\": \"{{password}}\"\n}"
            }
          }
        },
        {
          "name": "Login — finance officer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usr\": \"finance@gdb.gov.gy\",\n  \"pwd\": \"{{password}}\"\n}"
            },
            "description": "The persona that MOVES MONEY. Disbursement, the payment file and collections answer to this login and refuse the underwriter."
          }
        },
        {
          "name": "Login — e-ID (finance officer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.identity.password_login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eid\": \"592-5555-0005\",\n  \"password\": \"{{eidPassword}}\"\n}"
            }
          }
        },
        {
          "name": "Login — e-ID (citizen)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.identity.password_login",
            "description": "Keycloak password grant with the e-ID as the username, then the ordinary Frappe sid session. 592-1111-0001 LINKS to the already-seeded citizen@example.gy — no duplicate account, so `provisioned` is false.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eid\": \"592-1111-0001\",\n  \"password\": \"{{eidPassword}}\"\n}"
            }
          }
        },
        {
          "name": "Login — e-ID (underwriter)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.identity.password_login",
            "description": "Signs in as the underwriter and keeps its FRAPPE roles — Keycloak grants none. `is_underwriter` comes back true.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eid\": \"592-2222-0002\",\n  \"password\": \"{{eidPassword}}\"\n}"
            }
          }
        },
        {
          "name": "Login — e-ID (provisions a new citizen)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.identity.password_login",
            "description": "No Frappe user exists for this e-ID: the first sign-in provisions a Website User with the Citizen role and answers `provisioned: true`. Bare digits (33333333333) are normalised to the same thing.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eid\": \"592-3333-0003\",\n  \"password\": \"{{eidPassword}}\"\n}"
            }
          }
        },
        {
          "name": "Login — e-ID (wrong password)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.identity.password_login",
            "description": "401 \"Incorrect e-ID or password.\" — deliberately the SAME answer an unknown e-ID gets, so the endpoint never reveals which e-IDs exist. Rate-limited to 8 attempts per e-ID per minute; the 9th is a 429.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eid\": \"592-2222-0002\",\n  \"password\": \"WrongPassword1!\"\n}"
            }
          }
        },
        {
          "name": "e-ID sign-in available?",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.identity.eid_login_available",
            "description": "False when any of keycloak_url / keycloak_realm / keycloak_client_id is unset (site_config, or the matching KEYCLOAK_* environment variable).",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        },
        {
          "name": "Signup (guest)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.api.signup",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Aisha Persaud\",\n  \"email\": \"aisha@example.gy\",\n  \"password\": \"Str0ng-Pass-2026\"\n}"
            }
          }
        },
        {
          "name": "Whoami",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.api.whoami",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/logout",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        }
      ]
    },
    {
      "name": "Citizen",
      "item": [
        {
          "name": "Save draft application",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.api.save_application",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loan_amount\": 450000,\n  \"purpose\": \"Expand the poultry pens\",\n  \"term_months\": 18,\n  \"monthly_income\": 90000,\n  \"phone\": \"+592-600-1234\",\n  \"business_stage\": \"New\",\n  \"business_name\": \"Kaieteur Poultry\"\n}"
            },
            "description": "A draft is not before the Bank. Copy the returned `name` into the loanName variable, attach documents, then submit."
          }
        },
        {
          "name": "Submit application (refused while evidence is missing)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.api.submit_application",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{loanName}}\"\n}"
            },
            "description": "Names the missing document types rather than simply refusing."
          }
        },
        {
          "name": "Discard draft",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.api.discard_application",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{loanName}}\"\n}"
            }
          }
        },
        {
          "name": "Apply for a loan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.api.apply_loan",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"loan_amount\": 2500000,\n  \"purpose\": \"Working capital for agro-processing business\",\n  \"term_months\": 36,\n  \"monthly_income\": 450000,\n  \"phone\": \"+592-600-1234\"\n}"
            },
            "description": "Save and submit in one call. Documents are optional at submission, so this succeeds with an empty shelf — use the two-phase flow above when the applicant wants to attach evidence first."
          }
        },
        {
          "name": "My loans (history)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.api.my_loans",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        },
        {
          "name": "Loan detail",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.api.loan_detail",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{loanName}}\"\n}"
            }
          }
        },
        {
          "name": "Loan account (schedule + dues)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.api.loan_account",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"application\": \"{{loanName}}\"\n}"
            },
            "description": "Returns loan: null until the bank books the loan, and an empty schedule until it is disbursed. Every figure is lending's own."
          }
        },
        {
          "name": "Make a repayment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.api.make_repayment",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"application\": \"{{loanName}}\",\n  \"amount\": 38442\n}"
            },
            "description": "Submits a lending Loan Repayment. Needs the loan to be Disbursed, Partially Disbursed or Active. Any cluster member may pay."
          }
        }
      ]
    },
    {
      "name": "Underwriter",
      "item": [
        {
          "name": "All loans (queue)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.api.all_loans",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Submitted\"\n}"
            }
          }
        },
        {
          "name": "Review — approve",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.api.review_loan",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{loanName}}\",\n  \"action\": \"approve\",\n  \"remarks\": \"Income verified; approved at standard rate.\"\n}"
            }
          }
        },
        {
          "name": "Review — reject",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.api.review_loan",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{loanName}}\",\n  \"action\": \"reject\",\n  \"remarks\": \"Debt-to-income ratio too high.\"\n}"
            }
          }
        },
        {
          "name": "Book loan (from an approved application)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.api.book_loan",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"application\": \"{{loanName}}\"\n}"
            },
            "description": "Creates the Loan via lending's own create_loan mapper and submits it (status Sanctioned). Approving does not book - this is a separate act."
          }
        },
        {
          "name": "Disburse loan — REFUSED for an underwriter",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.api.disburse_loan",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"application\": \"{{loanName}}\"\n}"
            },
            "description": "Money movement is the finance officer's. Signed in as the underwriter this answers \"Only the GDB finance officer may do this.\" Sign in as finance@gdb.gov.gy and repeat it to see the release.\n\nA second gate sits behind the role: disburse_loan also refuses whoever approved the case, so one account holding both roles still cannot decide and pay the same application."
          }
        },
        {
          "name": "Add a condition precedent (after the offer went out)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.conditions.add_condition",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"application\": \"{{loanName}}\",\n  \"description\": \"Site visit to the pens completed.\"\n}"
            },
            "description": "Blocks release exactly like a condition from the Letter of Offer."
          }
        },
        {
          "name": "Record a repayment — REFUSED for staff",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.api.make_repayment",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"application\": \"{{loanName}}\",\n  \"amount\": 25000\n}"
            },
            "description": "The payment box is the borrower's. Bank-side receipts go through collections.apply_receipt, which starts from a Bank Transaction — money that actually arrived."
          }
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "1. New shelf row",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.documents.new_document",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document_type\": \"Identity\"\n}"
            },
            "description": "Omit `application` for a personal document; it follows the person across applications. Copy the returned `name` into documentName."
          }
        },
        {
          "name": "2. Upload the PDF (Frappe's own endpoint, multipart)",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/method/upload_file",
            "description": "NOT a gdb_bank endpoint. Attaching to the shelf row is what makes the private file readable by the applicant and by staff and by nobody else — File.has_permission delegates to the attached doc.\n\nLeave Content-Type unset: Postman writes the multipart boundary. Pick a PDF for the `file` field (10 MB max).",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "doctype",
                  "value": "GDB Applicant Document",
                  "type": "text"
                },
                {
                  "key": "docname",
                  "value": "{{documentName}}",
                  "type": "text"
                },
                {
                  "key": "is_private",
                  "value": "1",
                  "type": "text"
                }
              ]
            }
          }
        },
        {
          "name": "3. Confirm the document",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.documents.confirm_document",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{documentName}}\"\n}"
            },
            "description": "Stamps the row, retires the previous document of the same type, and closes the information request it answers."
          }
        },
        {
          "name": "The shelf (documents + what is still missing)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.documents.list_documents",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"application\": \"{{loanName}}\"\n}"
            }
          }
        },
        {
          "name": "A cluster member's own shelf (staff only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.documents.list_documents",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"applicant\": \"asha.persaud@example.gy\"\n}"
            }
          }
        },
        {
          "name": "Delete a document (drafts only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.documents.delete_document",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{documentName}}\"\n}"
            }
          }
        },
        {
          "name": "Review a document — reject with a reason (underwriter)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.documents.review_document",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{documentName}}\",\n  \"status\": \"Rejected\",\n  \"note\": \"Only three months are shown.\"\n}"
            }
          }
        },
        {
          "name": "Request information (underwriter)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.documents.request_information",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"application\": \"{{loanName}}\",\n  \"item\": \"Six months of bank statements\",\n  \"document_type\": \"Bank Statement\"\n}"
            },
            "description": "An itemised ask both sides can see. The applicant answers by uploading with `request` set, and it closes itself."
          }
        },
        {
          "name": "Answer a request (applicant) — step 1",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.documents.new_document",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document_type\": \"Bank Statement\",\n  \"application\": \"{{loanName}}\",\n  \"request\": \"{{requestName}}\"\n}"
            }
          }
        },
        {
          "name": "Withdraw a request (underwriter)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.documents.withdraw_request",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{requestName}}\"\n}"
            }
          }
        },
        {
          "name": "What has been asked for on this case",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.documents.list_requests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"application\": \"{{loanName}}\"\n}"
            }
          }
        }
      ],
      "description": "Evidence. Adding one takes three calls and the middle one is the framework's own upload_file — see the request descriptions."
    },
    {
      "name": "Profile & cluster",
      "item": [
        {
          "name": "My details",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.profiles.my_profile",
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          }
        },
        {
          "name": "Save my details (declared half only)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.profiles.save_profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+592-677-4411\",\n  \"occupation\": \"Poultry farmer\",\n  \"region\": \"Region 4 \\u2014 Demerara-Mahaica\",\n  \"village_or_town\": \"Mahaica\",\n  \"next_of_kin\": \"R. Persaud\",\n  \"next_of_kin_phone\": \"+592-677-4412\"\n}"
            },
            "description": "The verified_* block is the e-ID directory's and cannot be written here."
          }
        },
        {
          "name": "One applicant's details (staff)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/method/gdb_bank.profiles.profile_of",
