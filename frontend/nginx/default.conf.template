# Rendered by the official nginx image's envsubst on start.
#   BACKEND_URL       — the gdb-backend service (e.g. http://gdb-backend:8000)
#   FRAPPE_SITE_NAME  — the Frappe site the backend should serve (gdb.localhost)
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Frappe-Site-Name ${FRAPPE_SITE_NAME};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location /files/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $http_host;
        proxy_set_header X-Frappe-Site-Name ${FRAPPE_SITE_NAME};
    }

    location / {
        try_files $uri /index.html;
    }
}
