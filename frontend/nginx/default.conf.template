# Rendered by the official nginx image's envsubst on start.
#   BACKEND_URL       — the gdb-backend service (e.g. http://gdb-backend:8000)
#   FRAPPE_SITE_NAME  — the Frappe site the backend should serve (gdb.localhost)
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Resolve the backend lazily via Docker's DNS (a variable in proxy_pass
    # defers resolution to request time) so nginx starts even when the backend
    # name is momentarily unresolvable instead of crash-looping on [emerg].
    resolver 127.0.0.11 valid=10s ipv6=off;

    location /api/ {
        set $gdb_backend ${BACKEND_URL};
        proxy_pass $gdb_backend;
        proxy_http_version 1.1;
        # Evidence arrives through here (POST /api/method/upload_file), and
        # nginx's default body limit is 1 MB — a tenth of what the app itself
        # accepts (documents.MAX_FILE_BYTES = 10 MB). Left at the default,
        # nginx refuses a legitimate scan with its own HTML 413 before Frappe
        # ever sees it, so the applicant is told nothing and cannot submit.
        # Sized above the app's cap on purpose: the limit that rejects a file
        # should be the one that can explain itself.
        client_max_body_size 12m;
        proxy_set_header Host $http_host;
        proxy_set_header X-Frappe-Site-Name ${FRAPPE_SITE_NAME};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location /files/ {
        set $gdb_backend ${BACKEND_URL};
        proxy_pass $gdb_backend;
        proxy_set_header Host $http_host;
        proxy_set_header X-Frappe-Site-Name ${FRAPPE_SITE_NAME};
    }

    # Uploaded evidence. Frappe checks permissions on every request to
    # /private/files/ (utils/response.download_private_file) and refuses a
    # guest outright, so proxying it is not opening the shelf to the world —
    # it is letting the framework answer for it.
    location /private/files/ {
        set $gdb_backend ${BACKEND_URL};
        proxy_pass $gdb_backend;
        proxy_set_header Host $http_host;
        proxy_set_header X-Frappe-Site-Name ${FRAPPE_SITE_NAME};
    }

    location / {
        try_files $uri /index.html;
    }
}
