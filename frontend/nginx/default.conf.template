# Rendered by the official nginx image's envsubst on start.
#   BACKEND_URL       — the gdb-backend service (e.g. http://gdb-backend:8000)
#   FRAPPE_SITE_NAME  — the Frappe site the backend should serve (gdb.localhost)
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Resolve the backend lazily via Docker's DNS (a variable in proxy_pass
    # defers resolution to request time) so nginx starts even when the backend
    # name is momentarily unresolvable instead of crash-looping on [emerg].
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Text compresses to a fraction of its size — the JS bundle, the CSS and
    # every JSON answer from the API. Images are already compressed.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain application/yaml;

    # Set here, at server level, and deliberately nowhere below: an add_header
    # inside a location REPLACES the server's, so the caching rules further
    # down use `expires` instead. SAMEORIGIN rather than DENY because the
    # portal shows an applicant's own PDF in a frame.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location /api/ {
        set $gdb_backend ${BACKEND_URL};
        proxy_pass $gdb_backend;
        proxy_http_version 1.1;
        # Evidence arrives through here (POST /api/method/upload_file), and
        # nginx's default body limit is 1 MB — a tenth of what the app itself
        # accepts (documents.MAX_FILE_BYTES = 10 MB). Left at the default,
        # nginx refuses a legitimate scan with its own HTML 413 before Frappe
        # ever sees it, so the applicant is told nothing and cannot submit.
        # Sized above the app's cap on purpose: the limit that rejects a file
        # should be the one that can explain itself.
        client_max_body_size 12m;
        proxy_set_header Host $http_host;
        proxy_set_header X-Frappe-Site-Name ${FRAPPE_SITE_NAME};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location /files/ {
        set $gdb_backend ${BACKEND_URL};
        proxy_pass $gdb_backend;
        proxy_set_header Host $http_host;
        proxy_set_header X-Frappe-Site-Name ${FRAPPE_SITE_NAME};
    }

    # Uploaded evidence. Frappe checks permissions on every request to
    # /private/files/ (utils/response.download_private_file) and refuses a
    # guest outright, so proxying it is not opening the shelf to the world —
    # it is letting the framework answer for it.
    location /private/files/ {
        set $gdb_backend ${BACKEND_URL};
        proxy_pass $gdb_backend;
        proxy_set_header Host $http_host;
        proxy_set_header X-Frappe-Site-Name ${FRAPPE_SITE_NAME};
    }

    # Vite fingerprints every file under /assets/, so a name never changes
    # meaning: a browser may keep it for a year and never ask again.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # The one file that must always be re-read. It names the current chunks;
    # cached, a browser goes on asking for the last release's.
    location = /index.html {
        expires -1;
    }

    location / {
        try_files $uri /index.html;
    }
}
