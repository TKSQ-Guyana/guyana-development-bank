# =============================================================================
# deploy.env - the ONLY file you edit. Copy:  cp deploy.env.example deploy.env
# No secrets here: tokens are passed as environment variables (see deploy.sh).
# =============================================================================

# Release to deploy -> ravinadh/gdb-backend:<VERSION>, ravinadh/gdb-frontend:<VERSION>
VERSION=v1

# Build & push the images if VERSION is not in Docker Hub yet (true/false).
# false = only deploy images that already exist.
BUILD_IMAGES=true

# Public hostnames (DNS must point at the Traefik load balancer)
DESK_HOST=erp.gdb.example.gov.gy          # ERPNext desk = Frappe site name
PORTAL_HOST=loans.gdb.example.gov.gy      # citizen portal

# cert-manager ClusterIssuer for TLS (kubectl get clusterissuer)
CLUSTER_ISSUER=letsencrypt-prod

# First Platform Admin (work email). Optional one-time password: PLATFORM_ADMIN_PASSWORD env var.
PLATFORM_ADMIN_EMAIL=admin@gdb.example.gov.gy

# Restrict the ERPNext desk to these source ranges (comma separated, empty = open)
DESK_ALLOWED_RANGES=

# Cluster access
KUBECONFIG=~/.kube/gdb-prod.yaml

# Outgoing email (gdb_bank.integrations.mail). Port 465 = SSL, 587 = STARTTLS.
# Put the real password only in the server's own env file, never in git.
GDB_SMTP_SERVER=webmail2.egov.gy
GDB_SMTP_PORT=465
GDB_SMTP_USER=gdb@notifications.gov.gy
GDB_SMTP_PASSWORD=
GDB_MAIL_SENDER=gdb

# SMS through Infobip: applicant texts and the sign-up / sign-in codes.
# Without all three, no text is sent and codes are a FIXED code (123456) shown
# on screen — never acceptable in production. GDB_SMS_OTP=0 forces the fixed code.
# On Kubernetes these live in the gdb-secrets Secret, not here (gdb-los/README.md).
INFOBIP_BASE_URL=https://peddel.api.infobip.com
INFOBIP_API_KEY=
INFOBIP_SENDER=

# Book-an-appointment requests one address may send an hour (default 1000).
GDB_APPOINTMENT_RATE_LIMIT=1000
